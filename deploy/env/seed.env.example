# Seed / first voter — copy to /etc/myapp/trembita.env (B-45)
# Matrix: deploy/env/matrix.md · Full reference: docs/env.md

# --- Required on every node ---
TREMBITA_LISTEN=0.0.0.0:443
TREMBITA_DATA_DIR=/var/lib/myapp/data
TREMBITA_CERT_DIR=/var/lib/myapp/certs
# Backup (stop node first): deploy/backup-restore.md · docs/ops/backup-restore.md

# --- Seed only: accept dynamic join ---
TREMBITA_ALLOW_JOIN=1
# Optional: allow voter joins (default join role is learner)
# TREMBITA_ALLOW_VOTER_JOIN=1

# Do NOT set on product elastic clusters:
# TREMBITA_NODE_ID, TREMBITA_PEERS, TREMBITA_JOIN_SEEDS

# --- Multi-node HTTP behind LB (same value on ALL nodes) ---
# TREMBITA_GATEWAY_SESSION_SECRET=change-me-min-16-bytes
# GATEWAY_TOKEN=protect-product-http-in-prod

# --- Drain / shutdown (align with systemd TimeoutStopSec in deploy/systemd/) ---
# TREMBITA_DRAIN_TIMEOUT=90s
# TREMBITA_HTTP_DRAIN_TIMEOUT=30s
# TREMBITA_GRACEFUL_LEAVE=1

# --- Coordination scale (optional — see B-32 / B-37 / B-44) ---
# TREMBITA_COORDINATION_PROFILE=jobs_backlog
# TREMBITA_COORDINATION_MAX_QUEUE_SHARDS=16
# TREMBITA_COORDINATION_MAX_RAFT_GROUPS=4

# --- Ops logging ---
# RUST_LOG=info,trembita::product_scale=info
