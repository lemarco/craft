# Elastic joiner — copy to /etc/myapp/trembita.env (B-45)
# Before first start: place node-0.pem in TREMBITA_CERT_DIR (join bootstrap).
# After join assigns an id, reload node-<id>.pem per docs/certs.md.

TREMBITA_LISTEN=0.0.0.0:443
TREMBITA_DATA_DIR=/var/lib/myapp/data
TREMBITA_CERT_DIR=/var/lib/myapp/certs

# Live seed reachable over QUIC (id@host:port — same as TREMBITA_LISTEN port)
TREMBITA_JOIN_SEEDS=1@seed.example.com:443

# Default join role is learner; for voter join uncomment BOTH lines:
# TREMBITA_JOIN_ROLE=voter
# (seed must set TREMBITA_ALLOW_VOTER_JOIN=1)

# Same secret on every node when using cluster session cookies
# TREMBITA_GATEWAY_SESSION_SECRET=change-me-min-16-bytes
# GATEWAY_TOKEN=protect-product-http-in-prod

# TREMBITA_DRAIN_TIMEOUT=90s
# TREMBITA_HTTP_DRAIN_TIMEOUT=30s
# TREMBITA_GRACEFUL_LEAVE=1

# RUST_LOG=info,trembita::net=warn
