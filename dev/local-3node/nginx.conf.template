upstream trembita_local_cluster {
    server host.docker.internal:${LOCAL_CLUSTER_NODE1_PORT};
    server host.docker.internal:${LOCAL_CLUSTER_NODE2_PORT};
    server host.docker.internal:${LOCAL_CLUSTER_NODE3_PORT};
}

server {
    listen 8080;
    location / {
        proxy_pass http://trembita_local_cluster;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
    }
}
