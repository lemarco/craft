# Copy to .env and paste the runner token from GitLab:
# Project/Group → Settings → CI/CD → Runners → New project runner
# Tags, untagged jobs, and lock state are configured in GitLab UI (glrt tokens).
# This runner uses tag: shared
GITLAB_URL=https://gitlab.com
GITLAB_RUNNER_TOKEN=glrt-xxxxxxxxxxxxxxxxxxxx
RUNNER_NAME=trembita-local-lecomp
